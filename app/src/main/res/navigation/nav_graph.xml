            app:argType="boolean" />
        <argument
            android:name="is_vaulted_folders_enabled"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="is_archived_folders_enabled"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="is_child_folders_enabled"
            android:defaultValue="false"
            app:argType="boolean" />
