        android:name="com.noto.app.ui.note.NoteDialogFragment"
        android:label="NoteDialogFragment">
        <argument
            android:name="folder_id"
            app:argType="long" />
        <argument
            android:name="note_id"
            app:argType="long" />
        <action
            android:id="@+id/action_noteDialogFragment_to_noteReminderDialogFragment"
