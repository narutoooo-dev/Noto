            android:id="@+id/action_noteFragment_to_newLabelDialogFragment"
            app:destination="@id/newLabelDialogFragment" />
        <action
            android:id="@+id/action_noteFragment_to_labelDialogFragment"
            app:destination="@id/labelDialogFragment" />
