        android:name="com.noto.app.ui.component.dialog.ConfirmationDialogFragment"
        android:label="ConfirmationDialogFragment">
        <argument
            android:name="confirmation"
            app:argType="string" />
        <argument
            android:name="description"
            app:argType="string" />
        <argument
            android:name="btn_text"
            app:argType="string" />
        <argument
            android:name="key"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="is_error"
            app:argType="boolean"
            android:defaultValue="true" />
    </dialog>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.noto.app.ui.settings.SettingsFragment"
