            android:id="@+id/action_mainFragment_to_folderDialogFragment"
            app:destination="@id/folderDialogFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="exit"
            android:defaultValue="false"
            app:argType="boolean" />
